# Push-only policy for a control-network host. Nothing may connect in.
# The host may open one kind of connection out: TCP 9000 to the ingest node.
# Replies to that connection are allowed back (established), nothing else is.
flush ruleset

table inet ot_push_only {
    counter inbound_dropped { }
    counter egress_dropped { }

    set ingest_nodes {
        type ipv4_addr
        elements = { 10.10.1.2 }
    }

    chain input {
        type filter hook input priority 0; policy drop;
        iif lo accept
        ct state established,related accept
        ct state invalid drop
        counter name inbound_dropped drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy drop;
        oif lo accept
        ct state established,related accept
        ip daddr @ingest_nodes tcp dport 9000 ct state new accept
        counter name egress_dropped drop
    }
}
